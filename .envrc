# direnv configuration — this repo's automatic project setup.
#
# One-time setup:
#   1. install direnv:  https://direnv.net   (and hook it into your shell)
#   2. from this repo:  direnv allow
#
# After that, every `cd` into the repo prepares the environment automatically:
# it ensures the uv-managed venv exists and activates it, so `pytest` is on
# PATH without the `uv run` prefix. (`uv run ...` and `uvx ...` still work too.)

# Seed .env once. The key stays empty here; put it in .env (never in this file),
# or leave it empty and each deploy prompts for it.
TARGET_FILE=".env"
if [ ! -f "$TARGET_FILE" ]; then
  echo "Creating $TARGET_FILE…"
  printf '%s\n' "LLAMA_API_KEY=" >"$TARGET_FILE"
fi
chmod 600 "$TARGET_FILE"

# Load shared environment variables
dotenv .env

# Re-run when dependencies change.
watch_file pyproject.toml
# Re-run when the pinned interpreter changes (e.g. someone ran `uv python pin`).
watch_file .python-version

if has uv; then
  # The venv is per-machine state (absolute — HOME, interpreter location). If this
  # repo moves between machines, or uv replaces its managed Python under a new
  # patch-versioned directory, the interpreter symlink dangles. Detect that and
  # rebuild rather than warn.
  VENV_DIR="./.venv"
  if [ -L "$VENV_DIR/bin/python" ] && ! "$VENV_DIR/bin/python" -c '' >/dev/null 2>&1; then
    log_status "Broken venv (interpreter gone) — rebuilding"
    rm -rf "$VENV_DIR"
  fi

  # Sync is cheap when already in sync; it also installs the pinned Python if missing.
  uv sync
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add .venv/bin
else
  echo "direnv: 'uv' not found — install uv (https://docs.astral.sh/uv/), then 'direnv reload'"
fi
